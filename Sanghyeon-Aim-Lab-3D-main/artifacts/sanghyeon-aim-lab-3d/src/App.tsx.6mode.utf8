                onChange={e=>
                  setCrosshair({
                    ...crosshair,
                    thickness:+e.target.value
                  })
                }
              />
            </label>

          </div>


          <div className="toggle-row">

            <label>
              <input
                type="checkbox"
                checked={crosshair.outline}
                onChange={e=>
                  setCrosshair({
                    ...crosshair,
                    outline:e.target.checked
                  })
                }
              />
              ?멸낸??            </label>

            <label>
              <input
