function readStorage<T>(key: string, fallback: T): T {
  try {
    const value = localStorage.getItem(key);
    return value ? (JSON.parse(value) as T) : fallback;
  } catch {
    return fallback;
  }
}

function saveStorage(key: string, value: unknown) {
  try { localStorage.setItem(key, JSON.stringify(value)); } catch { /* storage is optional */ }
}

function normalizeSettings(raw: unknown): Settings {
  if (!raw || typeof raw !== 'object') return DEFAULT_SETTINGS;
  const value = raw as { sensitivity?: unknown; crosshair?: unknown };
  const sensitivity = typeof value.sensitivity === 'number' ? value.sensitivity : DEFAULT_SETTINGS.sensitivity;
  if (typeof value.crosshair === 'number') return { sensitivity, crosshair: { ...DEFAULT_CROSSHAIR, size: value.crosshair } };
  if (value.crosshair && typeof value.crosshair === 'object') return { sensitivity, crosshair: { ...DEFAULT_CROSSHAIR, ...(value.crosshair as Partial<CrosshairConfig>) } };
  return { sensitivity, crosshair: DEFAULT_CROSSHAIR };
}

function CrosshairView({ config, className = '' }: { config: CrosshairConfig; className?: string }) {
  if (config.style === 'dot') return <div className={`crosshair-view ${className}`} style={{ width: config.size, height: config.size }}><i style={{ width: config.thickness * 2 + 2, height: config.thickness * 2 + 2, background: config.color, boxShadow: config.outline ? '0 0 0 1px #050709' : 'none' }} /></div>;
  const line = { background: config.color, boxShadow: config.outline ? '0 0 0 1px #050709' : 'none' };
  const length = Math.max(4, config.size / 2 - config.gap - 3);
  return <div className={`crosshair-view ${className}`} style={{ width: config.size, height: config.size }}>
    <span style={{ ...line, width: config.thickness, height: length, left: '50%', top: 0, transform: 'translateX(-50%)' }} />
    <span style={{ ...line, width: config.thickness, height: length, left: '50%', bottom: 0, transform: 'translateX(-50%)' }} />
    <span style={{ ...line, width: length, height: config.thickness, left: 0, top: '50%', transform: 'translateY(-50%)' }} />
    <span style={{ ...line, width: length, height: config.thickness, right: 0, top: '50%', transform: 'translateY(-50%)' }} />
    {config.centerDot && <i style={{ position: 'absolute', width: config.thickness + 1, height: config.thickness + 1, borderRadius: '50%', background: config.color, left: '50%', top: '50%', transform: 'translate(-50%,-50%)' }} />}
  </div>;
}

